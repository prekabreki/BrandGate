_local/
.venv/
__pycache__/
*.pyc
# The ledger is the provenance artifact and is tracked, and so are the run
# scripts and the sameness run's figure, sheets and threshold table (#10).
# Everything else in runs/ (logs, scratch output) is not.
runs/*
!runs/ledger.jsonl
!runs/*.py
!runs/sameness/
# The drift run's three artifacts (#9): the raw table, the figure and the
# scorecard. The 96 frames behind them are not tracked, see surfaces/_drift.
!runs/drift/

# Hunting frames. Only a chosen surface graduates out of _scratch into the repo.
surfaces/_scratch/
# Calibration frames: many, large, and regenerable from the ledger's seeds. The
# LABELS in docs/ are the durable artifact, not the pixels.
surfaces/_calibration/
# Photoshop sources stay out of git; commit the PNG/SVG exports beside them.
*.psd
lookdev/_render*

# Vercel link state and pulled env; the project is 'handsel' on Pétur's account.
.vercel/
.env*

# Parked calibration sets and local run logs.
surfaces/_calibration-*/
_calibrate-*.log

# The drift arms (#9): 48 grounds per model, same prompt version, same seeds,
# regenerable from the ledger. Lives on the 4080 box only, like the pool.
surfaces/_drift/

# The sameness pool (#10): 200 grounds, one model, one tier, regenerable from
# the ledger's seeds. Lives on the 4080 box only. _pool-v4 and any later
# _pool-vN (#22) are the same thing at a later prompt version.
surfaces/_pool/
surfaces/_pool-v*/

# The connector binary; build it with `go build` in connector/.
connector/brandgate-connector

# The ident frames: 180 PNGs, 326 MB, regenerable from ident.html by surfaces/motion/render.py.
surfaces/motion/out/frames/
surfaces/motion/out/masks/
surfaces/motion/out/refused/frames/
surfaces/motion/out/refused/masks/
